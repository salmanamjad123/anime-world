# ===========================================
# Anime Village - Environment Variables
# Copy to .env.local and fill in your values
# ===========================================

# --- Firebase (Client - required for auth) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (Server - API routes, verification, forgot password) ---
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# --- Email (Resend — verify animevillage.org in Resend dashboard) ---
RESEND_API_KEY=re_xxxxxxxx
# Optional override (default: Anime Village <hello@animevillage.org>)
# EMAIL_FROM=Anime Village <hello@animevillage.org>

# --- Admin panel (/admin) — comma-separated emails allowed to send engagement mail ---
# ADMIN_EMAILS=you@example.com,other@example.com

# --- Site (optional - defaults exist) ---
NEXT_PUBLIC_SITE_NAME=Anime Village
NEXT_PUBLIC_SITE_URL=https://animevillage.org

# --- Streaming API (Anikoto-backed, HiAnime-compatible) ---
# Production (Vercel): Railway URL
# NEXT_PUBLIC_HIANIME_API_URL=https://streaming-api-july-production.up.railway.app
#
# Local dev: put overrides in anime-world/.env.local (not .env — keeps Vercel pull intact)
#   cd ../streaming-api && pnpm dev          # port 4000
#   cd anime-world && pnpm dev               # reads .env.local
# NEXT_PUBLIC_HIANIME_API_URL=http://localhost:4000
# NEXT_PUBLIC_USE_PROXY=true                 # uses /api/proxy locally

# --- Video proxy (put HLS on Cloudflare Worker to cut Railway egress) ---
# Deploy: cd cf-worker && npx wrangler deploy
# NEXT_PUBLIC_USE_PROXY=true
# NEXT_PUBLIC_PROXY_URL=https://anime-world-proxy.<subdomain>.workers.dev/proxy

# --- Cloudinary (avatars, profile, comments, replies) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Images (Vercel Image Optimization) ---
# Default: skip optimizer site-wide so covers still load after quota is hit.
# Set to false only if you want Vercel Image Optimization again.
# NEXT_PUBLIC_IMAGES_UNOPTIMIZED=true

# --- Stream cache / proxy ---
# HLS links expire in ~5 min; stale links: add ?refresh=true to /api/stream/...
# NEXT_PUBLIC_USE_PROXY=true
# NEXT_PUBLIC_PROXY_URL=https://anime-world-proxy.<subdomain>.workers.dev/proxy

# --- Optional: Redis, Analytics, Cron ---
# REDIS_URL=
# NEXT_PUBLIC_GA_ID=
# CRON_SECRET=
# Daily IG/TikTok draft → Discord (Vercel cron calls /api/cron/social-post)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# OPENSUBTITLES_API_KEY=
# ENABLE_PROXY_CACHE=
# PROXY_CACHE_MAX_AGE=
# ENABLE_RATE_LIMITING=
# RATE_LIMIT_MAX_REQUESTS=
# RATE_LIMIT_WINDOW_MS=
